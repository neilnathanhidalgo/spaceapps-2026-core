# ---- App ----
APP_NAME=spaceapps-core
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed CORS origins; "*" to allow all.
CORS_ORIGINS=*

# ---- Pilot defaults (used by /features and health probes) ----
DEFAULT_LAT=-5.19
DEFAULT_LON=-80.63

# ---- Cache ----
CACHE_DIR=.cache
CACHE_TTL_FORECAST=1800
CACHE_TTL_HISTORY=86400
CACHE_TTL_PROJECTIONS=604800
CACHE_TTL_SATELLITE=43200

# ---- HTTP ----
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# ---- NASA Earthdata (AppEEARS + earthaccess) ----
# Register for free at https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ---- Copernicus Data Space (optional) ----
# Register at https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
